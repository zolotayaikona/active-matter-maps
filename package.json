{
  "name": "active-matter-maps-activity",
  "version": "1.0.0",
  "private": true,
  "description": "Discord Activity with interactive maps for the game Active Matter",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "convert": "node tools/convert-maps.mjs",
